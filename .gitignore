# ── 认证与敏感信息 ─────────────────────────────
# 会话 token / 密钥 / 环境变量（禁止提交）
session.json
*.session.json
.env
.env.*
*.pem
*.key
!*.example

# ── Rust ───────────────────────────────────────
# Cargo.lock 对二进制项目应提交以保证可复现构建，故不忽略
# 仅忽略根目录 backend/target/ 编译产物；src/infra/target/ 是源码目录，不忽略
backend/target/
backend/.cargo/config.toml
# 外置插件（plugins/<name>）的编译产物；其 Cargo.lock 需提交（保证与宿主依赖一致）
plugins/*/target/

# ── 前端 ─────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.svelte-kit/

# ── Python ─────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── 测试/临时产物 ──────────────────────────────
*.tmp
*.download
*.log

# ─── 本地专属（不随仓库分发）──────────────────
# 会话记忆：开发过程中的决策/踩坑记录，只对本机有意义
# （此前无规则兜底、仅靠"不 git add"维持 ⇒ 一次 `git add -A` 就会误提交，故显式固化）
docs/memory/
.codebuddy/

# ─── 打包产物与二进制 ─────────────────────────
# fnOS .fpk 打包输出（Scripts/build_fnos_app.sh 产物）
/dist/
# 大二进制一律不入库：fpk 安装包、登录器可执行文件、浏览器扩展。
# 【教训 · 2026-09-28】历史上曾有 4 个二进制被误提交进 bin/（16 个 blob，解压共 1.16 GiB），
# 删除后仍永久留在 Git 历史里，把仓库撑到 670 MB；最终只能改写 95 个提交的 hash 才清掉。
# 这些文件是**构建/运行产物**，不该进版本库 —— 下述规则防止重犯。
*.fpk
*.xpi
# 登录器（PyInstaller 产物，单个 70–220 MB）
kzwr_login_*
# 注意：不要笼统忽略 bin/ 或 *.so —— plugins/*/ 下的 .so 是**产物**，
# 但 packaging/ 与 Scripts/ 里的脚本需要入库（曾误以为 bin/ 已被忽略，实际没有）。