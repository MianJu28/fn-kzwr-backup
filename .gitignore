# ── 认证与敏感信息 ─────────────────────────────
# 会话 token / 密钥 / 环境变量（禁止提交）
session.json
*.session.json
.env
.env.*
*.pem
*.key
!*.example

# ── Rust ───────────────────────────────────────
# Cargo.lock 对二进制项目应提交以保证可复现构建，故不忽略
# 仅忽略根目录 backend/target/ 编译产物；src/infra/target/ 是源码目录，不忽略
backend/target/
backend/.cargo/config.toml

# ── 前端 ─────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.svelte-kit/

# ── Python ─────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── 测试/临时产物 ──────────────────────────────
*.tmp
*.download
*.log

.codebuddy/