#!/bin/bash
#
# 卸载回调：卸载清理后执行。
# 仅在用户选择清除数据时删除持久数据（$TRIM_PKGVAR）与配置（$TRIM_PKGETC）。
# 默认保留数据，避免误删用户备份元数据。wizard/uninstall 用 select 返回 keep/purge。
# 注意：不使用 set -e，避免任一命令非零退出导致飞牛判定"执行脚本出错"。

APPDEST="${TRIM_APPDEST:-/var/apps/fnos-backup/target}"
PKGVAR="${TRIM_PKGVAR:-$APPDEST/var}"
PKGETC="${TRIM_PKGETC:-$APPDEST/etc}"

if [ "${wizard_purge_data:-keep}" = "purge" ]; then
    rm -rf "$PKGVAR" "$PKGETC" 2>/dev/null || true
    echo "已清除 fnos-backup 数据与配置。"
fi

exit 0
