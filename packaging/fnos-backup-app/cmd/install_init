#!/bin/bash
#
# 安装初始化：在应用文件应用前执行。
# 负责建目录、设权限、落盘安装向导收集的管理员口令（作为密钥库口令）。
#
# 参考：docs/fnnas-dev-docs/core-concepts/01-framework.md（安装流程）
#
# 向导值以环境变量传入（不使用 TRIM_ 前缀）：
#   wizard_http_port     HTTP 服务端口（默认 8080）
#   wizard_admin_pass    管理员口令（用于配置/age 密钥库加密）
#
# 注意：不使用 set -e，避免任一命令非零退出导致飞牛判定"执行脚本出错"。
# 所有非关键命令显式用 || true 容错。

APPDEST="${TRIM_APPDEST:-/var/apps/fnos-backup/target}"
PKGETC="${TRIM_PKGETC:-$APPDEST/etc}"
PKGVAR="${TRIM_PKGVAR:-$APPDEST/var}"
APPTMP="${TRIM_PKGTMP:-$APPDEST/tmp}"
APP_USER="${TRIM_USERNAME:-fnosbackup}"
APP_GROUP="${TRIM_GROUPNAME:-fnosbackup}"

mkdir -p "$PKGETC" "$PKGVAR" "$APPTMP" "$APPDEST/bin"
chown -R "$APP_USER:$APP_GROUP" "$PKGETC" "$PKGVAR" "$APPTMP" 2>/dev/null || true

# ── 管理员口令 → 密钥库口令 ──
PASSPHRASE_FILE="$PKGETC/.passphrase"
if [ -n "${wizard_admin_pass:-}" ]; then
    PASSPHRASE="$wizard_admin_pass"
elif [ -f "$PASSPHRASE_FILE" ]; then
    PASSPHRASE="$(cat "$PASSPHRASE_FILE")"
else
    # 生成随机口令（避免管道 SIGPIPE：分步执行）
    PASSPHRASE="$(head -c 32 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -dc 'A-Za-z0-9' 2>/dev/null | cut -c1-24)"
    [ -z "$PASSPHRASE" ] && PASSPHRASE="fnos-backup-initsetup"
fi
echo -n "$PASSPHRASE" >"$PASSPHRASE_FILE" 2>/dev/null || true
chown "$APP_USER:$APP_GROUP" "$PASSPHRASE_FILE" 2>/dev/null || true
chmod 600 "$PASSPHRASE_FILE" 2>/dev/null || true

# ── HTTP 端口 ──
if [ -n "${wizard_http_port:-}" ]; then
    mkdir -p "$PKGETC"
    echo -n "$wizard_http_port" >"$PKGETC/.port" 2>/dev/null || true
    chown "$APP_USER:$APP_GROUP" "$PKGETC/.port" 2>/dev/null || true
fi

# ══════════════════════════════════════════════════════════════
# Camoufox 登录运行环境准备（登录二进制运行时经 XDG_CACHE_HOME 定位）
#  - 浏览器二进制：国内镜像 curl 下载（若 fpk 内置 app/cache 则直接解压）
#  - uBlock Origin addon：随 fpk 打包，安装时解压
#  - Xvfb + Firefox 运行时库：apt 安装（headless="virtual" 需要）
# ══════════════════════════════════════════════════════════════
LOGIN_CACHE_DIR="$APPDEST/cache"
CAMO_DIR="$LOGIN_CACHE_DIR/camoufox"
UBO_DIR="$CAMO_DIR/addons/UBO"
INSTALL_LOG="$PKGETC/.install.log"
mkdir -p "$LOGIN_CACHE_DIR" "$CAMO_DIR" "$UBO_DIR" 2>/dev/null || true

log_i() { echo "[install_init] $*" >>"$INSTALL_LOG" 2>/dev/null || true; }

# ── 1. 国内镜像源列表（用户可在安装向导/环境变量中选择）──
# 选择顺序：KZWR_LOGIN_MIRROR 显式指定 > 默认列表（逐个尝试）
MIRROR_DEFAULT="gh-proxy.com ghproxy.net ghfast.top"
if [ -n "${KZWR_LOGIN_MIRROR:-}" ]; then
    MIRROR_LIST="$KZWR_LOGIN_MIRROR"
else
    MIRROR_LIST="$MIRROR_DEFAULT"
fi

# Camoufox 浏览器版本（默认 DEPLOY_FNVM 实测可用版本；可用 KZWR_CAMOUFOX_VERSION 覆盖）
CAMOUFOX_VERSION="${KZWR_CAMOUFOX_VERSION:-152.0.4-beta.28}"
# 资产名 pattern：camoufox-{version}-{build}-lin.x86_64.zip；build 未知，尝试候选
UBO_URL_BASE="https://github.com/gorhill/uBlock/releases/download/1.73.0"

download_via_mirror() {
    # $1=GitHub 原始 URL；$2=目标文件；依次用国内镜像尝试
    local url="$1" out="$2" m
    for m in $MIRROR_LIST; do
        log_i "尝试镜像 $m ..."
        if curl -sL --connect-timeout 20 --max-time 1200 -o "$out" "https://$m/$url"; then
            [ -s "$out" ] && return 0
        fi
        rm -f "$out" 2>/dev/null || true
    done
    return 1
}

# ── 2. Camoufox 浏览器 ──
if [ -x "$CAMO_DIR/camoufox-bin" ]; then
    log_i "Camoufox 浏览器已就绪：$CAMO_DIR"
elif [ -f "$APPDEST/cache/camoufox-browser.zip" ]; then
    # fpk 内置浏览器 zip（构建时预下载），直接解压
    log_i "从 fpk 内置浏览器 zip 解压 ..."
    cd "$CAMO_DIR" && unzip -o "$APPDEST/cache/camoufox-browser.zip" 2>/dev/null && \
        chmod +x "$CAMO_DIR/camoufox-bin" 2>/dev/null || true
else
    log_i "未找到内置浏览器，开始国内镜像下载 Camoufox ${CAMOUFOX_VERSION} ..."
    TMP_ZIP="$APPTMP/camoufox-browser.zip"
    rm -f "$TMP_ZIP" 2>/dev/null || true
    # 资产名候选（build 未知，枚举可能后缀；首选中含 lin.x86_64 的）
    CAMO_DL_OK=""
    for asset in \
        "camoufox-${CAMOUFOX_VERSION}-lin.x86_64.zip" \
        "camoufox-${CAMOUFOX_VERSION}-1-lin.x86_64.zip" \
        "camoufox-${CAMOUFOX_VERSION}-0-lin.x86_64.zip"; do
        if download_via_mirror "https://github.com/daijro/camoufox/releases/download/${CAMOUFOX_VERSION}/${asset}" "$TMP_ZIP"; then
            CAMO_DL_OK="1"; break
        fi
    done
    if [ -n "$CAMO_DL_OK" ]; then
        cd "$CAMO_DIR" && unzip -o "$TMP_ZIP" 2>/dev/null && \
            chmod +x "$CAMO_DIR/camoufox-bin" 2>/dev/null || true
        rm -f "$TMP_ZIP" 2>/dev/null || true
    else
        log_i "警告：Camoufox 浏览器下载失败。登录功能暂不可用，请检查网络/镜像源。"
    fi
fi

# ── 3. uBlock Origin addon（随 fpk 打包，安装时解压）──
# 源码 manifest.json 缺失会导致 camoufox 报 InvalidAddonPath，故必须解压。
if [ -f "$APPDEST/cache/ubo.xpi" ]; then
    log_i "解压 uBlock Origin addon ..."
    rm -rf "$UBO_DIR" 2>/dev/null || true
    mkdir -p "$UBO_DIR" 2>/dev/null || true
    ( cd "$UBO_DIR" && unzip -o "$APPDEST/cache/ubo.xpi" 2>/dev/null ) || true
    if [ ! -f "$UBO_DIR/manifest.json" ]; then
        log_i "警告：uBlock addon 解压后缺少 manifest.json"
    fi
fi

# ── 4. Xvfb + Firefox 运行时库（headless="virtual" 需要）──
if ! command -v Xvfb >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1; then
    log_i "安装 Xvfb 与 Firefox 运行时库 ..."
    apt-get update >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        xvfb \
        libgtk-3-0 libdbus-glib-1-2 libasound2 \
        libx11-xcb1 libxtst6 libxrandr2 libxcomposite1 \
        libxdamage1 libxfixes3 >/dev/null 2>&1 || true
fi

# 缓存目录属主改为应用用户（登录二进制以其运行）
chown -R "$APP_USER:$APP_GROUP" "$LOGIN_CACHE_DIR" 2>/dev/null || true

exit 0
